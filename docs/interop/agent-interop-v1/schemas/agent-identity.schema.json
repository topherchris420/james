{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-interop/v1/agent-identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "system", "agent_id", "display_name", "role", "kind", "capabilities", "revision", "created_at", "sha256"],
  "properties": {
    "schema": { "const": "agent-identity/v1" },
    "system": { "enum": ["james-desktop", "rain-lab"] },
    "agent_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "role": { "type": "string", "minLength": 1, "maxLength": 120 },
    "kind": { "enum": ["model-seat", "host-seat", "person"] },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,63}$" }
    },
    "revision": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
